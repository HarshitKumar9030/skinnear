{
  "name": "skinnear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "catalog:validate": "python scripts/catalog.py validate",
    "catalog:seed": "python scripts/catalog.py seed",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.ts\" \"*.{json,ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/*.ts\" \"*.{json,ts,mjs}\"",
    "deployment:check": "node --env-file-if-exists=.env.local scripts/check-deployment.mjs",
    "verify": "npm run format:check && npm run lint && npm test && npm run build && npm run typecheck"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "country-to-currency": "^3.0.1",
    "gsap": "^3.15.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.0.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
