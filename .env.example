# Local demo works without secrets. Never commit .env.local.
# Set only when MongoDB is running, e.g. mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DATABASE=skinnear
# YouCam v2 uses the API key directly as a Bearer token; no API secret needed.
YOUCAM_API_KEY=
# Set this to the API origin documented for your account/region.
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Production daily global limit for explanation + voice requests; localhost bypasses quotas.
GEMINI_DAILY_REQUEST_LIMIT=200
IPINFO_TOKEN=
# Vercel uses its own trusted IP headers automatically.
# On other hosts, only enable when your deployment strips and sets the visitor IP header.
TRUST_PROXY_HEADERS=false
# For public deployment, your proxy must strip/overwrite this header.
# e.g. x-forwarded-for, only behind a trusted proxy with no direct server access.
CLIENT_IP_HEADER=
# Canonical public origin, e.g. https://skinnear.example.com
APP_ORIGIN=
# Hard cap on attempted scans across all visitors per UTC day.
YOUCAM_DAILY_SCAN_LIMIT=100
# Required for stable scan tokens across restarts/multiple server processes.
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
TASK_SIGNING_SECRET=
